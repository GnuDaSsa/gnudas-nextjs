# ===========================================
# CLOVA Studio (HyperCLOVA X) Configuration
# ===========================================
# 네이버 클라우드 플랫폼 콘솔 > AI Services > CLOVA Studio > API 키 에서 발급
# Test API Key 또는 Service API Key 사용 가능

# 필수: CLOVA Studio API Key
CLOVA_API_KEY=sk-your-clova-api-key
# 또는 (구버전 호환)
# CLOVASTUDIO_API_KEY=sk-your-clova-api-key

# 선택: 모델 지정 (미지정 시 기본값 사용)
# 텍스트 모델: HCX-003 (기본), HCX-DASH-001 (경량)
CLOVA_TEXT_MODEL=HCX-003

# 비전/이미지 이해 모델: HCX-005 (기본), HCX-DASH-002 (경량)
CLOVA_VISION_MODEL=HCX-005

# 이미지 생성 모델: CLOVA Studio는 미지원 (DALL-E 등 별도 연동 필요)
# CLOVA_IMAGE_MODEL=unsupported

# 오디오 모델: CLOVA Studio는 미지원 (Clova Speech 등 별도 연동 필요)
# CLOVA_AUDIO_MODEL=unsupported

# 선택: 로컬 env 파일 경로 (기본값: C:\Users\Owner\Desktop\사진우\AI\clova api.env)
# CLOVA_ENV_PATH=C:\path\to\clova\api.env


# ===========================================
# Local Model CLI (Alternative)
# ===========================================
# USE_LOCAL_MODEL=true 로 설정하면 factchat 인터페이스로 로컬 CLI 호출
# USE_LOCAL_MODEL=true

# 로컬 모델 프로바이더: auto | claude-code | codex
# LOCAL_MODEL_PROVIDER=auto

# 로컬 모델 이름 (claude-code: sonnet/opus/opus-5.0 등, codex: gpt-5.5/gpt-5.6 등)
# LOCAL_MODEL_NAME=claude-sonnet-4-6

# Codex reasoning effort: low | medium | high | xhigh
# LOCAL_MODEL_REASONING=xhigh

# 타임아웃 (ms)
# LOCAL_MODEL_TIMEOUT=120000


# ===========================================
# Current Model Context (GJC Internal)
# ===========================================
# USE_CURRENT_MODEL=true 로 설정하면 현재 모델 컨텍스트 직접 사용
# USE_CURRENT_MODEL=false


# ===========================================
# Legacy FactChat (Deprecated - keep for backward compat)
# ===========================================
# FACTCHAT_API_KEY=sk-factchat-api-key
# FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# FACTCHAT_MODEL=claude-sonnet-4-6
# FACTCHAT_IMAGE_MODEL=gpt-image-2
# FACTCHAT_AUDIO_MODEL=gemini-2.5-flash
# FACTCHAT_ENV_PATH=C:\Users\Owner\Desktop\사진우\AI\factchat api.env