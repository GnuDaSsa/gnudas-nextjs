# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Seongnam FactChat Gateway
FACTCHAT_API_KEY=your_factchat_api_key
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
FACTCHAT_MODEL=claude-sonnet-4-6
FACTCHAT_AUDIO_MODEL=gemini-2.5-flash
FACTCHAT_IMAGE_MODEL=gemini-2.5-flash-image

# 국가법령정보센터 Open API OC 값
LAW_API_OC=your_oc_value
